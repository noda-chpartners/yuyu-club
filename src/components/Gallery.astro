---
import { Image } from 'astro:assets';
import navyBag from '@/assets/images/navy-bag.jpg';
import navyPair from '@/assets/images/IMG_2604.jpg';
import twoBags from '@/assets/images/IMG_2605.jpg';
import horsePanel from '@/assets/images/horse-panel.jpg';
import flowerBag from '@/assets/images/IMG_2609.jpg';
import colorfulBags from '@/assets/images/IMG_2610.jpg';
import colorfulBaskets from '@/assets/images/IMG_2611.jpg';
import wovenDrawers from '@/assets/images/IMG_2601.jpg';
import pairedBags from '@/assets/images/paired-bags.jpg';
import navyBasket from '@/assets/images/navy-basket.jpg';
import SectionHeading from '@/components/SectionHeading.astro';

const items = [
  { src: colorfulBaskets, alt: '黄色、ピンク、紫のクラフトバンドで編まれたかごバッグ', shape: 'wide' },
  { src: navyBag, alt: '紺色と多色の紙バンドで編まれたバッグ', shape: 'tall' },
  { src: twoBags, alt: 'ベージュと紺色のクラフトバンドバッグ', shape: 'wide' },
  { src: flowerBag, alt: '黄緑の花柄バッグと茶色のかごバッグ', shape: 'square' },
  { src: horsePanel, alt: '走る馬のモチーフを編み込んだ壁飾り', shape: 'tall' },
  { src: colorfulBags, alt: 'ピンクと黄色のクラフトバンドで編まれたかごバッグ', shape: 'wide' },
  { src: wovenDrawers, alt: '紙バンドで編まれた引き出し収納', shape: 'tall' },
  { src: navyPair, alt: '紺色に多色のラインを織り込んだバッグとかご', shape: 'wide' },
  { src: pairedBags, alt: '茶色と紺色の紙バンドで編まれた2つのバッグ', shape: 'square' },
  { src: navyBasket, alt: '紺色と多色の紙バンドで編まれた縦長のバスケット', shape: 'tall' },
] as const;
---

<section class="gallery section" id="gallery" aria-labelledby="gallery-heading">
  <div class="gallery__head container" id="gallery-heading" data-reveal>
    <SectionHeading
      english="GALLERY"
      title="作品紹介"
      lead="バッグ、かご、収納、壁飾り。色と編み方の組み合わせで、表情はいくらでも広がります。"
      watermark="GALLERY"
    />
  </div>

  <div class="gallery__scroller" data-gallery>
    <ul class="gallery__track" data-gallery-track>
      {items.map((item, index) => (
        <li class:list={['gallery__item', `gallery__item--${item.shape}`]}>
          <figure class="gallery__figure">
            <Image
              class="gallery__image"
              src={item.src}
              alt={item.alt}
              widths={[420, 640, 900]}
              sizes="(max-width: 760px) 78vw, 30vw"
              format="webp"
            />
            <figcaption class="gallery__caption">
              <span class="gallery__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="gallery__alt">{item.alt}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <div class="gallery__controls container">
    <p class="gallery__hint">横にスクロールしてご覧ください</p>
    <div class="gallery__buttons">
      <button class="gallery__button focusable" type="button" aria-label="前の作品へ" data-gallery-prev>←</button>
      <button class="gallery__button focusable" type="button" aria-label="次の作品へ" data-gallery-next>→</button>
    </div>
  </div>
</section>
