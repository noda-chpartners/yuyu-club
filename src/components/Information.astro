---
import { site } from '@/data/site';
import SectionHeading from '@/components/SectionHeading.astro';
---

<section class="information section" id="information" aria-labelledby="information-heading">
  <div class="information__weave" aria-hidden="true"></div>
  <div class="information__inner container">
    <div class="information__heading" id="information-heading" data-reveal>
      <SectionHeading
        eyebrow="INFORMATION"
        title="営業・教室案内"
        description="営業日と教室の時間をご確認ください。"
      />
    </div>

    <div class="information__grid">
      <div class="information__panel" data-reveal>
        <h3 class="information__panel-title">営業案内</h3>
        <dl class="information__list">
          <div class="information__row">
            <dt class="information__term">営業日</dt>
            <dd class="information__description">{site.businessDays}</dd>
          </div>
          <div class="information__row">
            <dt class="information__term">営業時間</dt>
            <dd class="information__description information__description--numeric">{site.businessHours}</dd>
          </div>
        </dl>
      </div>

      <div class="information__panel information__panel--lessons" data-reveal>
        <h3 class="information__panel-title">教室時間</h3>
        <ol class="lesson-list">
          {site.lessons.map((lesson) => (
            <li class="lesson-list__item">
              <span class="lesson-list__number">{lesson.number}</span>
              <span class="lesson-list__time">{lesson.time}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="access" data-reveal>
      <div class="access__heading">
        <p class="access__eyebrow">ACCESS</p>
        <h3 class="access__title">遊結倶楽部</h3>
        <p class="access__reading">ゆうゆうくらぶ</p>
      </div>
      <dl class="access__details">
        <div class="access__row">
          <dt class="access__term">住所</dt>
          <dd class="access__description">{site.address}</dd>
        </div>
        <div class="access__row">
          <dt class="access__term">電車</dt>
          <dd class="access__description">{site.station}</dd>
        </div>
        <div class="access__row">
          <dt class="access__term">メール</dt>
          <dd class="access__description">
            <a class="access__phone focusable" href={site.emailHref}>{site.emailDisplay}</a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
