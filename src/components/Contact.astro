---
import { site } from '@/data/site';
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <span class="contact__watermark" aria-hidden="true">CONTACT</span>
  <div class="contact__inner container" data-reveal>
    <p class="contact__english">CONTACT</p>
    <h2 class="contact__title" id="contact-heading">お問い合わせ・ご予約</h2>
    <p class="contact__lead">
      体験教室のご予約、出張講座やデザインのご相談は、メールまたはお電話でお気軽にどうぞ。
    </p>

    <div class="contact__actions">
      <a class="contact__button contact__button--primary focusable" href={site.emailHref}>
        <span class="contact__button-label">メールで問い合わせる</span>
        <span class="contact__button-value">{site.emailDisplay}</span>
      </a>
      <a class="contact__button focusable" href={site.phoneHref}>
        <span class="contact__button-label">お電話で問い合わせる</span>
        <span class="contact__button-value contact__button-value--tel">{site.phoneDisplay}</span>
      </a>
    </div>

    <p class="contact__hours">受付時間 {site.businessHours}（{site.businessDays}）</p>

    <a class="contact__instagram focusable" href={site.instagram.href} target="_blank" rel="noopener">
      <span class="contact__instagram-label">Instagram</span>
      <span class="contact__instagram-value">{site.instagram.label}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
