---
interface Props {
  eyebrow: string;
  title: string | string[];
  description?: string;
  align?: 'left' | 'center';
  theme?: 'light' | 'dark';
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  theme = 'light',
} = Astro.props;

const titleLines = Array.isArray(title) ? title : [title];
---

<div class:list={['section-heading', `section-heading--${align}`, `section-heading--${theme}`]}>
  <div class="section-heading__eyebrow-row">
    <span class="section-heading__line" aria-hidden="true"></span>
    <p class="section-heading__eyebrow">{eyebrow}</p>
  </div>
  <h2 class="section-heading__title">
    {titleLines.map((line) => <span class="section-heading__title-line">{line}</span>)}
  </h2>
  {description && <p class="section-heading__description">{description}</p>}
</div>
