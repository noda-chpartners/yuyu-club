---
interface Props {
  english: string;
  title: string;
  lead?: string;
  align?: 'center' | 'left';
  tone?: 'default' | 'inverse';
  watermark?: string;
}

const { english, title, lead, align = 'center', tone = 'default', watermark } = Astro.props;
---

<div class:list={['heading', `heading--${align}`, `heading--${tone}`]}>
  {watermark && <span class="heading__watermark" aria-hidden="true">{watermark}</span>}
  <p class="heading__english">{english}</p>
  <h2 class="heading__title">{title}</h2>
  <span class="heading__rule" aria-hidden="true"></span>
  {lead && <p class="heading__lead">{lead}</p>}
</div>
