---
import '@/styles/page.scss';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Topics from '@/components/Topics.astro';
import Concept from '@/components/Concept.astro';
import Features from '@/components/Features.astro';
import Menu from '@/components/Menu.astro';
import Gallery from '@/components/Gallery.astro';
import Flow from '@/components/Flow.astro';
import Information from '@/components/Information.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';

const title = '遊結倶楽部（ゆうゆうくらぶ）｜茨城県鹿嶋市のクラフトバンド教室と PP バンド';
const description =
  '茨城県鹿嶋市の遊結倶楽部。クラフトバンド教室と PP バンド、クラフトバンド・紙バンド、手芸用品、雑貨・猫雑貨の販売。はじめてのカゴ体験 2,000円（材料込み・要予約）。出張・出前講座も承ります。';
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="site-main" id="main-content">
    <Hero />
    <div class="site-sheet">
      <Topics />
      <Concept />
      <Features />
      <Menu />
      <Gallery />
      <Flow />
      <Information />
      <Contact />
    </div>
  </main>
  <Footer />
</BaseLayout>
