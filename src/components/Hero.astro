---
import { Image } from 'astro:assets';
import colorfulBaskets from '@/assets/images/IMG_2611.jpg';
import materialsShelf from '@/assets/images/materials-shelf.jpg';
import twoBags from '@/assets/images/IMG_2605.jpg';
import { site } from '@/data/site';

const slides = [
  { src: colorfulBaskets, alt: '黄色、ピンク、紫のクラフトバンドで編まれたかごバッグ' },
  { src: materialsShelf, alt: '色とりどりのクラフトバンドが並ぶ店内の棚' },
  { src: twoBags, alt: 'ベージュと紺色のクラフトバンドバッグ' },
];
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="hero__slides" aria-hidden="true">
    {slides.map((slide, index) => (
      <figure class:list={['hero__slide', { 'is-active': index === 0 }]} data-hero-slide>
        <Image
          class="hero__image"
          src={slide.src}
          alt=""
          widths={[720, 1080, 1600, 2000]}
          sizes="100vw"
          format="webp"
          quality={78}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
      </figure>
    ))}
    <div class="hero__tint"></div>
  </div>

  <span class="hero__watermark" aria-hidden="true">YUYU</span>

  <div class="hero__content">
    <div class="hero__copy" data-hero-copy>
      <p class="hero__place">KASHIMA, IBARAKI — CRAFT BAND STUDIO &amp; SHOP</p>
      <h1 class="hero__title" id="hero-title">
        <span class="hero__title-line">遊ぶように編み、</span>
        <span class="hero__title-line">結ぶように集う。</span>
      </h1>
      <p class="hero__english">Weave, play, and gather.</p>
      <p class="hero__lead">{site.tagline}｜{site.name}（{site.reading}）</p>
    </div>

    <div class="hero__bottom">
      <ol class="hero__dots" aria-label="スライド">
        {slides.map((slide, index) => (
          <li>
            <button
              class:list={['hero__dot', { 'is-active': index === 0 }]}
              type="button"
              aria-label={`スライド ${index + 1}: ${slide.alt}`}
              aria-current={index === 0 ? 'true' : undefined}
              data-hero-dot={index}
            ></button>
          </li>
        ))}
      </ol>
      <a class="hero__scroll focusable" href="#topics">
        <span class="hero__scroll-label">SCROLL</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>
