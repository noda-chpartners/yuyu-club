---
import BrandMark from '@/components/BrandMark.astro';
import { navigation, site } from '@/data/site';
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__top">
      <a class="footer__brand focusable" href="#top" aria-label="遊結倶楽部 トップへ">
        <BrandMark inverse />
      </a>
      <nav class="footer__nav" aria-label="フッターナビゲーション">
        <ul class="footer__nav-list">
          {navigation.map((item) => (
            <li class="footer__nav-item">
              <a class="footer__nav-link focusable" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer__bottom">
      <address class="footer__address">
        <span class="footer__address-line">{site.address}</span>
        <a class="footer__phone focusable" href={site.phoneHref}>TEL {site.phoneDisplay}</a>
      </address>
      <p class="footer__copyright">© YUYU CLUB</p>
    </div>
  </div>
</footer>
