---
import { site } from '@/data/site';

interface Props {
  size?: 'default' | 'large';
}

const { size = 'default' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`]}>
  <span class="wordmark__name">{site.name}</span>
  <span class="wordmark__english">{site.english}</span>
</span>
